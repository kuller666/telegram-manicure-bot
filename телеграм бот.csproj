<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Единое корневое пространство имён для читаемости и совместимости с инструментами -->
    <RootNamespace>TelegramManicureBot</RootNamespace>
    <AssemblyName>TelegramManicureBot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
    <!-- Клиент Telegram Bot API (webhook + отправка сообщений) -->
    <PackageReference Include="Telegram.Bot" Version="22.4.4" />
    <!-- EF Core + SQLite для локального старта (позже можно заменить на Npgsql) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
